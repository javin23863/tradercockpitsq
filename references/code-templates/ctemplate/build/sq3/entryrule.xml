                     <Rule type="IfThen" everyTick="false">
                        <Descriptions></Descriptions>
                        <If>
                            <Item key="AND" identification="RandomConditionLong">
                                <Block>
                                    <Item key="NoTradeRecentlyClosed"  name="No Trade Recently Closed" display="NoTradeRecentlyClosed(#Symbol#, #MagicNumber#, )" returnType="boolean" categoryType="simpleRules">
                                       <Param  key="#Symbol#" name="Symbol" type="string" defaultValue="Current" displayOnDefault="false" controlType="symbolVarWithAny" paramType="symbol">Current</Param>
                                       <Param  key="#MagicNumber#" variable="true" variableType="INT" name="Magic Number" type="int" defaultValue="MagicNumber" displayOnDefault="false" controlType="comboVarWithAny"></Param>
                                       <Param  key="#CheckThisBar#" name="Check This Bar" type="boolean" defaultValue="true" controlType="booleanVar">true</Param>
                                       <Param  key="#CheckThisMinute#" name="Check This Minute" type="boolean" defaultValue="true" controlType="booleanVar">true</Param>
                                    </Item>
                                </Block>
                                <Block>
                                    <Item returnType="boolean" ignoreInBuilder="true" randomTemplate="true" superType="condition">
                                       <Param  key="#Identification#" name="Identification" type="string" controlType="randomId"></Param>
                                    </Item>
                                </Block>
                            </Item>
                        </If>
                        <Then>
                        </Then>
                    </Rule>